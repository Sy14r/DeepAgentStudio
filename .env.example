# DeepAgentStudio Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=deepagent
POSTGRES_PASSWORD=your-secure-database-password-here
POSTGRES_DB=deepagentstudio
DATABASE_URL=postgresql://deepagent:your-secure-database-password-here@deepagent_postgres:5432/deepagentstudio

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT signing key - generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-jwt-secret-key-here-generate-with-openssl

# JWT configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# ENCRYPTION
# =============================================================================
# Fernet encryption key for API keys - generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# =============================================================================
# CORS (Comma-separated list of allowed origins)
# =============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# OPTIONAL: LLM Provider API Keys
# These can also be configured per-user in the UI
# =============================================================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# OPTIONAL: Development Settings
# =============================================================================
# DEBUG=true
# LOG_LEVEL=DEBUG

# =============================================================================
# OPTIONAL: Workspace Configuration
# =============================================================================
# WORKSPACE_MAX_SIZE_MB=100
# WORKSPACE_FILE_MAX_SIZE_MB=10
# MAX_MEDIA_FILE_SIZE_MB=50
