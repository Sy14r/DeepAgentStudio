# Database Configuration
DATABASE_URL=postgresql://deepagent:deepagent@postgres:5432/deepagentstudio

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Key Encryption
# Generate a new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Example valid key: u3Uc-qAi9yCMm7XIp7-jMwPlJzYyiMn2B0xXhZ_BbRA=
ENCRYPTION_KEY=u3Uc-qAi9yCMm7XIp7-jMwPlJzYyiMn2B0xXhZ_BbRA=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENVIRONMENT=development

# ===========================================
# LLM Provider API Keys (Optional)
# ===========================================
# These are used for integration testing and can also be used
# as default keys for agent execution if configured.
#
# IMPORTANT: Never commit actual API keys! Copy this file to .env
# and add your real keys there. The .env file is git-ignored.

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
